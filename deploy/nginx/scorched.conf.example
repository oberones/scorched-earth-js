# Host nginx (TLS terminated here) -> container bound to 127.0.0.1:8095.
# Put the map in the http {} context once; the location blocks go in your HTTPS server.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# Option A: dedicated hostname, e.g. https://scorched.example.com/
#   location / { ...same proxy settings as below, proxy_pass http://127.0.0.1:8095; }

# Option B: path prefix, e.g. https://example.com/games/scorched/
location = /games/scorched { return 308 /games/scorched/; }
location /games/scorched/ {
    proxy_pass http://127.0.0.1:8095/;          # trailing slash strips the prefix
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;      # WebSocket upgrade for /ws
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $http_host;            # the server compares this with the browser Origin
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;                     # server pings every 25 s; keep idle sockets alive
}
# For a proxy container on the web-backend network use http://scorched-earth:8080/ instead.

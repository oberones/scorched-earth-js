# Replace owner/repository with the lowercase GitHub repository path.
# Prefer ghcr.io/owner/repository@sha256:<digest> from the workflow summary.
SCORCHED_IMAGE=ghcr.io/owner/repository:0.1.0
SCORCHED_PLATFORM=linux/amd64
SCORCHED_PORT=8095
SCORCHED_NETWORK=web-backend
SCORCHED_LOG_LEVEL=info
# Extra browser origins allowed to open the game socket (same-host pages always are).
SCORCHED_ALLOWED_ORIGINS=
SCORCHED_MAX_CLIENTS=1000
SCORCHED_MAX_ROOMS=200

{
  "name": "scorched-earth",
  "version": "0.2.1",
  "private": true,
  "description": "Scorched Earth artillery game for the browser, with a zero-dependency multiplayer server",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/server.js",
    "build": "node tools/build.js",
    "models": "python3 tools/export_models.py",
    "test": "node tests/headless.test.js && node tests/multiplayer.test.js",
    "test:engine": "node tests/headless.test.js",
    "test:multiplayer": "node tests/multiplayer.test.js",
    "test:release": "node --test scripts/release-metadata.test.mjs",
    "test:browser": "python3 tests/browser_check.py && python3 tests/multiplayer_browser.py",
    "test:delivery": "node scripts/check-delivery.mjs",
    "test:container": "bash scripts/check-container.sh",
    "validate": "npm run test:release && npm run build && npm test && npm run test:browser"
  }
}
